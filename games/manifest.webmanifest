{
  "name": "Disc0 Games",
  "short_name": "Games",
  "description": "Simple, relaxing games for your phone. No ads, works offline.",
  "id": "/games/",
  "start_url": "/games/",
  "scope": "/games/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#efe7d3",
  "theme_color": "#0b6e6e",
  "icons": [
    { "src": "/games/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/games/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/games/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
